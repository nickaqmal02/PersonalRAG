# LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.1
MAX_TOKENS=1024

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
SCORE_THRESHOLD=0.2

# Paths
DATA_DIR=./data
VECTOR_STORE_DIR=./data/vector_store

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Logging
LOG_LEVEL=INFO
